# Database Configuration
MONGO_URI=mongodb://localhost:27017/nextgenhr
DB_NAME=nextgenhr

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_COOKIE_EXPIRE=7

# Email Configuration
# Choose email service: 'gmail' or 'smtp'
EMAIL_SERVICE=gmail

# Gmail Configuration (if using Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
# Note: For Gmail, you need to generate an App Password from Google Account Settings
# Go to: Google Account > Security > 2-Step Verification > App passwords

# Custom SMTP Configuration (if using custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Email Settings
EMAIL_FROM_NAME=NextGenHR
HR_EMAIL=hr@yourcompany.com
COMPANY_WEBSITE=https://www.yourcompany.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
