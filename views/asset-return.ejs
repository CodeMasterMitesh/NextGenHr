<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Asset Return</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#returnModal">
            <i class="bi bi-plus-circle"></i> New Return
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Total Assets Returned</h6>
                        <h3 class="mb-0">98</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="mb-0">7</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Assets in Use</h6>
                        <h3 class="mb-0">145</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Asset Return Records</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Asset ID</th>
                                <th>Asset Type</th>
                                <th>Serial Number</th>
                                <th>Returned By</th>
                                <th>Return Date</th>
                                <th>Condition</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>AST-052</strong></td>
                                <td><span class="badge bg-primary">Laptop</span></td>
                                <td>LAP-56789</td>
                                <td>Mike Johnson</td>
                                <td>Dec 5, 2025</td>
                                <td><span class="badge bg-success">Good</span></td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Return Asset Modal -->
<div class="modal fade" id="returnModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Return Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-select">
                            <option>Select Employee</option>
                            <option>John Doe</option>
                            <option>Sarah Smith</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Asset</label>
                        <select class="form-select">
                            <option>Select Asset</option>
                            <option>AST-001 - Laptop (LAP-12345)</option>
                            <option>AST-002 - Monitor</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Return Date</label>
                        <input type="date" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Condition</label>
                        <select class="form-select">
                            <option>Select Condition</option>
                            <option>Good</option>
                            <option>Fair</option>
                            <option>Damaged</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Return</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
