<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Payslips</h5>
                <small class="text-muted">Review generated payslips</small>
            </div>
            <a href="/payslips/add" class="btn btn-primary" data-spa>
                <i class="bi bi-plus-circle"></i> Generate Payslip
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover" id="payslipTable">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Period</th>
                                    <th>Net Pay</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>John Doe</td>
                                    <td>Jan 2024</td>
                                    <td>$4,500</td>
                                    <td><span class="badge bg-success">Issued</span></td>
                                    <td>
                                        <a href="/payslips/view/1" class="btn btn-sm btn-info" data-spa><i class="bi bi-eye"></i></a>
                                        <a href="/payslips/edit/1" class="btn btn-sm btn-warning" data-spa><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function initPayslipsList(){
      if (window.$ && $.fn.DataTable) {
        $('#payslipTable').DataTable({ order: [] });
      }
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
