<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt me-2"></i>Payslip Details</h2>
    <div>
      <a href="/payslips/edit/<%= payslip.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/payslips" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Payslips
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Payslip for January 2025</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Employee Information</h6>
          <p class="mb-1"><strong>Name:</strong> John Doe</p>
          <p class="mb-1"><strong>Employee Code:</strong> EMP001</p>
          <p class="mb-1"><strong>Designation:</strong> Senior Developer</p>
          <p class="mb-1"><strong>Department:</strong> IT</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Payslip Information</h6>
          <p class="mb-1"><strong>Month:</strong> January 2025</p>
          <p class="mb-1"><strong>Pay Date:</strong> 31/01/2025</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Paid</span></p>
        </div>
      </div>

      <hr>

      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Earnings</h6>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Basic Salary</td>
                <td class="text-end">₹50,000</td>
              </tr>
              <tr>
                <td>House Rent Allowance</td>
                <td class="text-end">₹7,000</td>
              </tr>
              <tr>
                <td>Transport Allowance</td>
                <td class="text-end">₹3,000</td>
              </tr>
              <tr class="table-primary">
                <td><strong>Total Earnings</strong></td>
                <td class="text-end"><strong>₹60,000</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Deductions</h6>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Provident Fund</td>
                <td class="text-end">₹3,000</td>
              </tr>
              <tr>
                <td>Income Tax</td>
                <td class="text-end">₹2,000</td>
              </tr>
              <tr>
                <td>Professional Tax</td>
                <td class="text-end">₹200</td>
              </tr>
              <tr class="table-danger">
                <td><strong>Total Deductions</strong></td>
                <td class="text-end"><strong>₹5,200</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <hr>

      <div class="row">
        <div class="col-12">
          <h5 class="text-success">Net Salary: ₹54,800</h5>
          <p class="text-muted">In words: Fifty Four Thousand Eight Hundred Only</p>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary">
          <i class="bi bi-download me-2"></i>Download PDF
        </button>
        <button class="btn btn-info">
          <i class="bi bi-printer me-2"></i>Print
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
