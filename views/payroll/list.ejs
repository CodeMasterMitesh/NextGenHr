<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Payroll</h5>
                <small class="text-muted">Manage employee payroll</small>
            </div>
            <a href="/payroll/add" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Process Payroll
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Month</th>
                                    <th>Basic Salary</th>
                                    <th>Deductions</th>
                                    <th>Net Salary</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>John Doe</td>
                                    <td>December 2025</td>
                                    <td>$5000</td>
                                    <td>$500</td>
                                    <td>$4500</td>
                                    <td><span class="badge bg-success">Paid</span></td>
                                    <td>
                                        <a href="/payroll/view/1" class="btn btn-sm btn-info" title="View"><i class="bi bi-eye"></i></a>
                                        <a href="/payslips/1" class="btn btn-sm btn-primary" title="Payslip"><i class="bi bi-file-text"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
