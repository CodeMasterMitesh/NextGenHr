<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Leave Request Details</h5>
                <small class="text-muted">Review request</small>
            </div>
            <a href="/leave-requests" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to Requests
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <h6 class="text-muted mb-1">Employee</h6>
                            <div class="fw-semibold">Jane Smith</div>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted mb-1">Dates</h6>
                            <div class="fw-semibold">2024-03-10 to 2024-03-14</div>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted mb-1">Type</h6>
                            <span class="badge bg-info text-dark">Annual Leave</span>
                        </div>
                        <div class="col-12">
                            <h6 class="text-muted mb-1">Reason</h6>
                            <p class="mb-0">Family event</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
