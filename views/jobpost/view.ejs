<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Job Post Details</h5>
                <small class="text-muted">Review job posting</small>
            </div>
            <a href="/jobpost" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to Posts
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-1">Title</h6>
                            <div class="fw-semibold">Senior Developer</div>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">Department</h6>
                            <div class="fw-semibold">Engineering</div>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">Status</h6>
                            <span class="badge bg-success">Open</span>
                        </div>
                        <div class="col-12">
                            <h6 class="text-muted mb-1">Description</h6>
                            <p class="mb-0">Build and maintain core platform features.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
