<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Employee Details</h5>
                <small class="text-muted">View complete employee information</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/employees/edit/<%= employee?._id || '' %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/employees" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <% if (employee?.photo_url) { %>
                                    <img src="<%= employee.photo_url %>" alt="Employee Photo" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                                <% } else { %>
                                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 150px; height: 150px; font-size: 48px;">
                                        <%= employee?.first_name?.charAt(0) || 'E' %><%= employee?.last_name?.charAt(0) || 'M' %>
                                    </div>
                                <% } %>
                            </div>
                            <h4><%= employee?.first_name || '' %> <%= employee?.last_name || '' %></h4>
                            <p class="text-muted"><%= employee?.designation || 'N/A' %></p>
                            <p class="badge bg-<%= employee?.status === 'confirmed' ? 'success' : employee?.status === 'probation' ? 'warning' : 'secondary' %>">
                                <%= employee?.status?.toUpperCase() || 'N/A' %>
                            </p>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="/employees/edit/<%= employee?._id || '' %>" class="btn btn-outline-warning">
                                    <i class="bi bi-pencil"></i> Edit Employee
                                </a>
                                <a href="/attendance?employee=<%= employee?._id || '' %>" class="btn btn-outline-primary">
                                    <i class="bi bi-calendar-check"></i> View Attendance
                                </a>
                                <a href="/leave-requests?employee=<%= employee?._id || '' %>" class="btn btn-outline-info">
                                    <i class="bi bi-calendar-x"></i> Leave History
                                </a>
                                <a href="/payslips?employee=<%= employee?._id || '' %>" class="btn btn-outline-success">
                                    <i class="bi bi-cash"></i> Payslips
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Personal Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Employee Code</label>
                                    <p class="fw-bold"><%= employee?.emp_code || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Email</label>
                                    <p class="fw-bold"><%= employee?.email || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Gender</label>
                                    <p class="fw-bold"><%= employee?.gender || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Date of Birth</label>
                                    <p class="fw-bold"><%= employee?.dob ? new Date(employee.dob).toLocaleDateString() : 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Contact Number</label>
                                    <p class="fw-bold"><%= employee?.contact_number || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Username</label>
                                    <p class="fw-bold"><%= employee?.username || 'N/A' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Employment Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Department</label>
                                    <p class="fw-bold"><%= employee?.department || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Designation</label>
                                    <p class="fw-bold"><%= employee?.designation || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Employment Type</label>
                                    <p class="fw-bold"><%= employee?.employment_type || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Join Date</label>
                                    <p class="fw-bold"><%= employee?.join_date ? new Date(employee.join_date).toLocaleDateString() : 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Role</label>
                                    <p class="fw-bold"><%= employee?.type || 'employee' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Status</label>
                                    <p>
                                        <span class="badge bg-<%= employee?.status === 'confirmed' ? 'success' : employee?.status === 'probation' ? 'warning' : 'secondary' %>">
                                            <%= employee?.status?.toUpperCase() || 'N/A' %>
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Address Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Address</label>
                                    <p class="fw-bold"><%= employee?.address_line1 || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="text-muted small">City</label>
                                    <p class="fw-bold"><%= employee?.address_city || 'N/A' %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">State</label>
                                    <p class="fw-bold"><%= employee?.address_state || 'N/A' %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Pincode</label>
                                    <p class="fw-bold"><%= employee?.address_pincode || 'N/A' %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
