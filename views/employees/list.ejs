<% if (!partial) { %>
<%- include ('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Employees</h5>
                <small class="text-muted">Manage your workforce</small>
            </div>
            <a href="/employees/add" class="btn btn-primary" data-spa>
                <i class="bi bi-plus-circle"></i> Add Employee
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="employeesTable" class="table table-hover table-striped" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Employee Code</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Department</th>
                                    <th>Designation</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                                <!-- Column filters -->
                                <tr class="filters">
                                    <th><input type="text" class="form-control form-control-sm" placeholder="Search code"></th>
                                    <th><input type="text" class="form-control form-control-sm" placeholder="Search name"></th>
                                    <th><input type="text" class="form-control form-control-sm" placeholder="Search email"></th>
                                    <th><input type="text" class="form-control form-control-sm" placeholder="Search department"></th>
                                    <th><input type="text" class="form-control form-control-sm" placeholder="Search designation"></th>
                                    <th>
                                        <select class="form-select form-select-sm">
                                            <option value="">All</option>
                                            <option value="Confirmed">Confirmed</option>
                                            <option value="Probation">Probation</option>
                                            <option value="Inactive">Inactive</option>
                                        </select>
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            // Initialize DataTable with custom filters
            const table = $('#employeesTable').DataTable({
                ajax : {
                    url: '/api/getEmployees',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'emp_code' },
                    { data: 'first_name' },
                    { data: 'email' },
                    { data: 'department' },
                    { data: 'designation' },
                    { 
                        data: 'status',
                        render: function(data) {
                            let badgeClass = 'secondary';
                            if (data === 'Confirmed') badgeClass = 'success';
                            else if (data === 'Probation') badgeClass = 'warning';
                            else if (data === 'Inactive') badgeClass = 'danger';
                            return `<span class="badge bg-${badgeClass}">${data}</span>`;
                        }
                    },
                    { 
                        data: null,
                        render: function(data, type, row) {
                            return `
                                <a href="/employees/view/${row._id}" class="btn btn-sm btn-info" data-spa>
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a href="/employees/edit/${row._id}" class="btn btn-sm btn-primary" data-spa>
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a href="/employees/delete/${row._id}" class="btn btn-sm btn-danger" data-id="${row._id}">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            `;
                        }
                    }
                ],
                dom: 'Bfrtip',
                // buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                pageLength: 25,
                orderCellsTop: true,
                fixedHeader: true,
                initComplete: function () {
                    const api = this.api();

                    // Apply filters for each column
                    api.columns().eq(0).each(function (colIdx) {
                        const cell = $('.filters th').eq(colIdx);
                        const input = $('input, select', cell);

                        input.off('keyup change').on('change', function () {
                            api.column(colIdx).search(this.value).draw();
                        }).on('keyup', function (e) {
                            e.stopPropagation();
                            $(this).trigger('change');
                        });
                    });
                }
            });

            // Handle delete button clicks
            $(document).on('click', '.btn-danger', async function (e) {
                e.preventDefault();
                const row = $(this).closest('tr');
                const empCode = row.find('td:first').text();
                const empName = row.find('td:nth-child(2)').text();
                const employeeId = $(this).attr('data-id');

                // Extract ID from href if data-id not present
                const href = $(this).attr('href');
                const id = employeeId || href.split('/').pop();

                const result = await CRUDHelper.delete(
                    `/api/deleteEmployee/${id}`,
                    empName || 'Employee'
                );

                if (result.success) {
                    row.fadeOut(300, function () {
                        $(this).remove();
                    });
                }

                if (result.cancelled) {
                    // User cancelled delete
                }
            });
        });
    </script>
<% if (!partial) { %>
<%- include ('../layouts/footer'); %>
<% } %>
