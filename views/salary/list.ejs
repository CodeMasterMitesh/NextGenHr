<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Salary Management</h5>
                <small class="text-muted">Manage salary structures</small>
            </div>
            <a href="/salary/add" class="btn btn-primary" data-spa>
                <i class="bi bi-plus-circle"></i> Add Salary
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover" id="salaryTable">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>CTC</th>
                                    <th>Effective From</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Jane Smith</td>
                                    <td>$60,000</td>
                                    <td>2024-01-01</td>
                                    <td>
                                        <a href="/salary/view/1" class="btn btn-sm btn-info" data-spa><i class="bi bi-eye"></i></a>
                                        <a href="/salary/edit/1" class="btn btn-sm btn-warning" data-spa><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function initSalaryList(){
      if (window.$ && $.fn.DataTable) {
        $('#salaryTable').DataTable({ order: [] });
      }
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
