<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Add Salary</h5>
                <small class="text-muted">Define salary package</small>
            </div>
            <a href="/salary" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <form id="salaryAddForm" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Employee</label>
                            <input type="text" class="form-control" name="employee" placeholder="Employee name">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CTC</label>
                            <input type="number" class="form-control" name="ctc" placeholder="0.00" step="0.01">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Effective From</label>
                            <input type="date" class="form-control" name="effective_from">
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Salary</button>
                            <a href="/salary" class="btn btn-secondary" data-spa><i class="bi bi-x-circle"></i> Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function initSalaryAdd(){
      const form = document.getElementById('salaryAddForm');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (window.Toast) Toast.success('Salary saved (demo)');
        if (window.spaNavigate) spaNavigate('/salary'); else window.location.href = '/salary';
      });
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
