<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cash-stack me-2"></i>Salary Details</h2>
    <div>
      <a href="/salary/edit/<%= salary.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/salary" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Salary
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Salary Structure</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Employee Information</h6>
          <p class="mb-1"><strong>Name:</strong> John Doe</p>
          <p class="mb-1"><strong>Employee Code:</strong> EMP001</p>
          <p class="mb-1"><strong>Designation:</strong> Senior Developer</p>
          <p class="mb-1"><strong>Department:</strong> IT</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Salary Information</h6>
          <p class="mb-1"><strong>Effective Date:</strong> 01/01/2025</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
          <p class="mb-1"><strong>Payment Mode:</strong> Bank Transfer</p>
        </div>
      </div>

      <hr>

      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Earnings</h6>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Basic Salary</td>
                <td class="text-end">₹50,000</td>
              </tr>
              <tr>
                <td>House Rent Allowance</td>
                <td class="text-end">₹7,000</td>
              </tr>
              <tr>
                <td>Transport Allowance</td>
                <td class="text-end">₹3,000</td>
              </tr>
              <tr>
                <td>Other Allowances</td>
                <td class="text-end">₹2,000</td>
              </tr>
              <tr class="table-success">
                <td><strong>Gross Salary</strong></td>
                <td class="text-end"><strong>₹62,000</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Deductions</h6>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Provident Fund (12%)</td>
                <td class="text-end">₹6,000</td>
              </tr>
              <tr>
                <td>Professional Tax</td>
                <td class="text-end">₹200</td>
              </tr>
              <tr>
                <td>Income Tax (TDS)</td>
                <td class="text-end">₹2,500</td>
              </tr>
              <tr class="table-danger">
                <td><strong>Total Deductions</strong></td>
                <td class="text-end"><strong>₹8,700</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <hr>

      <div class="row">
        <div class="col-12">
          <h5 class="text-primary">Net Salary: ₹53,300</h5>
          <p class="text-muted mb-2"><strong>Remarks:</strong> Salary revised as per annual appraisal</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
