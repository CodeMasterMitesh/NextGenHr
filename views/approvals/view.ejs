<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-check-circle me-2"></i>Approval Details</h2>
    <div>
      <a href="/approvals/edit/<%= approval.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/approvals" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Approvals
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-warning text-dark">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0">Leave Request - John Doe</h5>
        <span class="badge bg-warning">Pending</span>
      </div>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Request Information</h6>
          <p class="mb-1"><strong>Type:</strong> <span class="badge bg-info">Leave Request</span></p>
          <p class="mb-1"><strong>Requested By:</strong> John Doe</p>
          <p class="mb-1"><strong>Employee Code:</strong> EMP001</p>
          <p class="mb-1"><strong>Department:</strong> IT</p>
          <p class="mb-1"><strong>Request Date:</strong> 15th January 2025</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Approval Details</h6>
          <p class="mb-1"><strong>Priority:</strong> <span class="badge bg-warning">Medium</span></p>
          <p class="mb-1"><strong>Approver:</strong> Manager Name</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning">Pending</span></p>
          <p class="mb-1"><strong>Due Date:</strong> 18th January 2025</p>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Request Details</h6>
        <p>Requesting 3 days leave from Jan 20-22 for personal reasons.</p>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Approver Notes</h6>
        <p class="text-muted">Under review</p>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Timeline</h6>
        <div class="list-group">
          <div class="list-group-item">
            <div class="d-flex w-100 justify-content-between">
              <h6 class="mb-1">Request Submitted</h6>
              <small>15/01/2025 10:30 AM</small>
            </div>
            <p class="mb-1">Request submitted by John Doe</p>
          </div>
          <div class="list-group-item">
            <div class="d-flex w-100 justify-content-between">
              <h6 class="mb-1">Assigned to Approver</h6>
              <small>15/01/2025 10:35 AM</small>
            </div>
            <p class="mb-1">Assigned to Manager Name for review</p>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success">
          <i class="bi bi-check-lg me-2"></i>Approve Request
        </button>
        <button class="btn btn-danger">
          <i class="bi bi-x-lg me-2"></i>Reject Request
        </button>
        <button class="btn btn-info">
          <i class="bi bi-chat-dots me-2"></i>Add Comment
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
