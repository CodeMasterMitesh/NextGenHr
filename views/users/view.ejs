<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">User Details</h5>
                <small class="text-muted">View complete user information</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/users/edit/<%= user?._id || '' %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/users" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 36px;">
                                    <i class="bi bi-person"></i>
                                </div>
                            </div>
                            <h4><%= user?.username || 'N/A' %></h4>
                            <p class="text-muted"><%= user?.email || 'N/A' %></p>
                            <p>
                                <span class="badge bg-<%= user?.type === 'admin' ? 'danger' : 'primary' %>">
                                    <%= user?.type?.toUpperCase() || 'USER' %>
                                </span>
                                <span class="badge bg-<%= user?.status === 'active' ? 'success' : 'secondary' %>">
                                    <%= user?.status?.toUpperCase() || 'ACTIVE' %>
                                </span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">User Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Username</label>
                                    <p class="fw-bold"><%= user?.username || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Email</label>
                                    <p class="fw-bold"><%= user?.email || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Role</label>
                                    <p><span class="badge bg-<%= user?.type === 'admin' ? 'danger' : 'primary' %>"><%= user?.type?.toUpperCase() || 'USER' %></span></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Status</label>
                                    <p><span class="badge bg-<%= user?.status === 'active' ? 'success' : 'secondary' %>"><%= user?.status?.toUpperCase() || 'ACTIVE' %></span></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Created At</label>
                                    <p class="fw-bold"><%= user?.createdAt ? new Date(user.createdAt).toLocaleString() : 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Last Login</label>
                                    <p class="fw-bold"><%= user?.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Activity Log</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">No recent activity</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
