<%- include ('layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Branches</h5>
                <small class="text-muted">Manage company branches</small>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#branchModal">
                <i class="bi bi-plus-circle"></i> Add Branch
            </button>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th>Branch Name</th>
                                    <th>Address Line 1</th>
                                    <th>Address Line 2</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Pincode</th>
                                    <th>Contact Number</th>
                                    <th>Email</th>
                                    <th>Manager</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="branchTableBody" width="100%" cellspacing="0" style="overflow-x: auto;">
                                <!-- Branch rows will be populated here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include ('modals/branch'); %>
    
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <img src="..." class="rounded me-2" alt="...">
                <strong class="me-auto">Bootstrap</strong>
                <small>11 mins ago</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body"></div>
        </div>
    </div>
    <%- include ('layouts/footer'); %>
        <script>
            // Initialize Bootstrap Modal and Toast
            const branchModal = new bootstrap.Modal(document.getElementById('branchModal'));
            const toastElement = document.getElementById('liveToast');
            const toastInstance = new bootstrap.Toast(toastElement);

            addEventListener('DOMContentLoaded', async () => {
                const response = await fetch('http://localhost:5000/getCompanyData');
                console.log(response);
                const companies = await response.json();
                console.log(companies);
                const companySelect = document.querySelector('select[name="company_id"]');
                companies.forEach(company => {
                    console.log(company);
                    const option = document.createElement('option');
                    option.value = company._id;
                    option.textContent = company.name;
                    companySelect.appendChild(option);
                });
            });

             addEventListener('DOMContentLoaded', async () => {
                const response = await fetch('http://localhost:5000/getBranch');
                // console.log(response);
                const branches = await response.json();
                branches.forEach(branch => {
                    console.log("branch", branch);
                    const tableBody = document.getElementById('branchTableBody');
                    const row = document.createElement('tr');

                    row.innerHTML += `
                        <td width="150">${branch.name}</td>
                        <td width="150">${branch.address1}</td>
                        <td width="150">${branch.address2 || ''}</td>
                        <td width="150">${branch.city}</td>
                        <td >${branch.state}</td>
                        <td>${branch.pincode}</td>
                        <td>${branch.contact_number}</td>
                        <td>${branch.email}</td>
                        <td>${branch.manager || ''}</td>
                        <td>
                            <button class="btn btn-sm btn-warning editBtn" data-id="${branch._id}"><i class="bi bi-pencil"></i></button>` +
                            `<a href="#" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
                attachEventListeners();
            });
            document.getElementById('branchForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const form = e.target;
                const formData = new FormData(form);
                // Convert FormData to plain object for JSON POST
                const data = {};
                formData.forEach((value, key) => { data[key] = value; });

                try {
                    const response = await fetch('http://localhost:5000/storeBranch', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();
                    console.log(result);
                    const responseMsg = document.querySelector('.toast-body');
                    if (result.success) {
                        responseMsg.innerHTML = `${result.message}`;
                        toastInstance.show();
                        branchModal.hide();
                        form.reset();
                    } else {
                        responseMsg.innerHTML = `<div class="alert alert-danger">${result.message || 'Something went wrong'}</div>`;
                        toastInstance.show();
                    }
                } catch (err) {
                    document.querySelector('.toast-body').innerHTML = `<div class="alert alert-danger">Network error: ${err.message}</div>`;
                    toastInstance.show();
                    console.error('Error submitting branch:', err);
                }
            });
            function attachEventListeners() {
            const editBtn = document.querySelectorAll('.editBtn');
            editBtn.forEach(button => {
                const branchId = button.getAttribute('data-id');
                console.log('Editing Branch ID:', branchId);
                
                button.addEventListener('click', async (e) => {
                    const response = await fetch(`http://localhost:5000/getBranch/${branchId}`, {
                        method: 'GET',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const branch = await response.json();
                    console.log('Branch Data:', branch);
                    const row = button.closest('tr');
                    const cells = row.getElementsByTagName('td');
                    // document.getElementById('editBranchId').value = cells[0].innerText;
                    // document.getElementById('editBranchName').value = cells[1].innerText;
                    // document.getElementById('editAddress1').value = cells[2].innerText;
                    // document.getElementById('editAddress2').value = cells[3].innerText;
                    // document.getElementById('editCity').value = cells[4].innerText;
                    // document.getElementById('editState').value = cells[5].innerText;
                    // document.getElementById('editPincode').value = cells[6].innerText;
                    // document.getElementById('editContactNumber').value = cells[7].innerText;
                    // document.getElementById('editEmail').value = cells[8].innerText;
                    // document.getElementById('editManager').value = cells[9].innerText;

                    const editBranchModal = new bootstrap.Modal(document.getElementById('editBranchModal'));
                    editBranchModal.show();
                });
            });
        }
        </script>