<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Department Details</h5>
                <small class="text-muted">View complete department information</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/departments/edit/<%= department?._id || '' %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/departments" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 36px;">
                                    <i class="bi bi-diagram-3"></i>
                                </div>
                            </div>
                            <h4><%= department?.name || 'N/A' %></h4>
                            <p class="text-muted"><%= department?.code || 'No code' %></p>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="/departments/edit/<%= department?._id || '' %>" class="btn btn-outline-warning">
                                    <i class="bi bi-pencil"></i> Edit Department
                                </a>
                                <a href="/employees?department=<%= department?._id || '' %>" class="btn btn-outline-primary">
                                    <i class="bi bi-people"></i> View Employees
                                </a>
                                <a href="/designations?department=<%= department?._id || '' %>" class="btn btn-outline-info">
                                    <i class="bi bi-award"></i> View Designations
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Department Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Department Name</label>
                                    <p class="fw-bold"><%= department?.name || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Department Code</label>
                                    <p class="fw-bold"><%= department?.code || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Head of Department</label>
                                    <p class="fw-bold"><%= department?.head_name || 'Not Assigned' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Parent Department</label>
                                    <p class="fw-bold"><%= department?.parent_name || 'None (Top Level)' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Description</label>
                                    <p class="fw-bold"><%= department?.description || 'No description provided' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Statistics</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-primary">0</h4>
                                        <small class="text-muted">Total Employees</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-success">0</h4>
                                        <small class="text-muted">Designations</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-info">0</h4>
                                        <small class="text-muted">Sub-Departments</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
