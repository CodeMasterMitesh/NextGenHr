<%- include ('layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Create Job Post</h5>
                <small class="text-muted">Create a new job posting</small>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <form id="jobPostForm" method="POST" action="/jobpost">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Job Title</label>
                                <input type="text" class="form-control" name="title" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Department</label>
                                <select class="form-select" name="department_id" required>
                                    <option value="">Select Department</option>
                                    <option value="1">IT</option>
                                    <option value="2">HR</option>
                                    <option value="3">Finance</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Number of Positions</label>
                                <input type="number" class="form-control" name="positions" min="1" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Job Type</label>
                                <select class="form-select" name="job_type">
                                    <option value="">Select Type</option>
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                    <option value="Contract">Contract</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Experience (Years)</label>
                                <input type="number" class="form-control" name="experience" min="0">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Salary Range (From)</label>
                                <input type="number" class="form-control" name="salary_from" placeholder="₹">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Salary Range (To)</label>
                            <input type="number" class="form-control" name="salary_to" placeholder="₹">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Job Description</label>
                            <textarea class="form-control" name="description" rows="6" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Requirements</label>
                            <textarea class="form-control" name="requirements" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Location</label>
                            <input type="text" class="form-control" name="location">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Posting Date</label>
                            <input type="date" class="form-control" name="posting_date">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Closing Date</label>
                            <input type="date" class="form-control" name="closing_date">
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Job Post</button>
                            <a href="/jobpost" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
<%- include ('layouts/footer'); %>
