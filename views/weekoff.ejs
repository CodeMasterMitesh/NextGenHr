<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Week-off Management</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#weekoffModal">
            <i class="bi bi-plus-circle"></i> New Week-off
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Week-off Schedule</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Shift</th>
                                <th>Week-off Day 1</th>
                                <th>Week-off Day 2</th>
                                <th>Applicable From</th>
                                <th>Applicable To</th>
                                <th>No. of Employees</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Morning Shift</strong></td>
                                <td>Saturday</td>
                                <td>Sunday</td>
                                <td>Jan 1, 2025</td>
                                <td>Dec 31, 2025</td>
                                <td>45</td>
                                <td>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Night Shift</strong></td>
                                <td>Tuesday</td>
                                <td>Wednesday</td>
                                <td>Jan 1, 2025</td>
                                <td>Dec 31, 2025</td>
                                <td>35</td>
                                <td>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Week-off Modal -->
<div class="modal fade" id="weekoffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Week-off</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Shift</label>
                        <select class="form-select">
                            <option>Select Shift</option>
                            <option>Morning Shift</option>
                            <option>Afternoon Shift</option>
                            <option>Night Shift</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Week-off Day 1</label>
                            <select class="form-select">
                                <option>Select Day</option>
                                <option>Monday</option>
                                <option>Tuesday</option>
                                <option>Wednesday</option>
                                <option>Thursday</option>
                                <option>Friday</option>
                                <option>Saturday</option>
                                <option>Sunday</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Week-off Day 2</label>
                            <select class="form-select">
                                <option>Select Day</option>
                                <option>Monday</option>
                                <option>Tuesday</option>
                                <option>Wednesday</option>
                                <option>Thursday</option>
                                <option>Friday</option>
                                <option>Saturday</option>
                                <option>Sunday</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Applicable From</label>
                            <input type="date" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Applicable To</label>
                            <input type="date" class="form-control">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
