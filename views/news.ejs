<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>News & Articles</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newsModal">
            <i class="bi bi-plus-circle"></i> New Article
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1">24</h3>
                        <p class="text-muted mb-0">Total Articles</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1">1.2K</h3>
                        <p class="text-muted mb-0">Total Views</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1">180</h3>
                        <p class="text-muted mb-0">This Month</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1">8</h3>
                        <p class="text-muted mb-0">This Week</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Recent Articles</h6>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">New HR Policy Update for 2026</h6>
                                <p class="text-muted small mb-2">Posted by <strong>Admin</strong> on Dec 18, 2025</p>
                                <p class="mb-0">Important updates to attendance policy, remote work guidelines, and leave policies effective from January 2026.</p>
                            </div>
                            <div class="ms-2">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">Leadership Training Program Starts Next Month</h6>
                                <p class="text-muted small mb-2">Posted by <strong>HR Manager</strong> on Dec 15, 2025</p>
                                <p class="mb-0">New comprehensive leadership training program for managers. Register now to secure your spot!</p>
                            </div>
                            <div class="ms-2">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">Annual Company Team Building Event</h6>
                                <p class="text-muted small mb-2">Posted by <strong>Events Team</strong> on Dec 10, 2025</p>
                                <p class="mb-0">Join us for our annual team building event on January 15, 2026 at City Club. All employees welcome!</p>
                            </div>
                            <div class="ms-2">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Article Modal -->
<div class="modal fade" id="newsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" placeholder="Article title">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select">
                            <option>Select Category</option>
                            <option>Policy Update</option>
                            <option>Training</option>
                            <option>Event</option>
                            <option>Achievement</option>
                            <option>General</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Content</label>
                        <textarea class="form-control" rows="5" placeholder="Article content"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select">
                            <option>Draft</option>
                            <option>Published</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Publish</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
