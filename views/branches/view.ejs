<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Branch Details</h5>
                <small class="text-muted">View complete branch information</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/branches/edit/<%= branch?._id || '' %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/branches" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff;">
                            <h6 class="mb-0">Branch Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 36px;">
                                    <i class="bi bi-building"></i>
                                </div>
                            </div>
                            <h5 class="text-center mb-1"><%= branch?.name || 'N/A' %></h5>
                            <p class="text-center text-muted small mb-3"><%= branch?.code || 'No code' %></p>
                            <hr>
                            <div class="mb-2">
                                <small class="text-muted">Company</small>
                                <p class="mb-0 fw-bold"><%= branch?.company_name || 'N/A' %></p>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Manager</small>
                                <p class="mb-0 fw-bold"><%= branch?.manager || 'Not assigned' %></p>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="/branches/edit/<%= branch?._id || '' %>" class="btn btn-outline-warning">
                                    <i class="bi bi-pencil"></i> Edit Branch
                                </a>
                                <a href="/employees?branch=<%= branch?._id || '' %>" class="btn btn-outline-primary">
                                    <i class="bi bi-people"></i> View Employees
                                </a>
                                <a href="/departments?branch=<%= branch?._id || '' %>" class="btn btn-outline-info">
                                    <i class="bi bi-diagram-3"></i> View Departments
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Contact Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Primary Contact</label>
                                    <p class="fw-bold"><%= branch?.contact_number || 'N/A' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Alternative Contact</label>
                                    <p class="fw-bold"><%= branch?.alternate_contact || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Email Address</label>
                                    <p class="fw-bold"><%= branch?.email || 'N/A' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Address Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Address Line 1</label>
                                    <p class="fw-bold"><%= branch?.address1 || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Address Line 2</label>
                                    <p class="fw-bold"><%= branch?.address2 || '-' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="text-muted small">City</label>
                                    <p class="fw-bold"><%= branch?.city || 'N/A' %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">State</label>
                                    <p class="fw-bold"><%= branch?.state || 'N/A' %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Pincode</label>
                                    <p class="fw-bold"><%= branch?.pincode || 'N/A' %></p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="text-muted small">Country</label>
                                    <p class="fw-bold"><%= branch?.country || 'N/A' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="mb-0">Statistics</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-primary">0</h4>
                                        <small class="text-muted">Total Employees</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-success">0</h4>
                                        <small class="text-muted">Departments</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <h4 class="mb-0 text-info">0</h4>
                                        <small class="text-muted">Active Projects</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
