<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Software Details</h5>
                <small class="text-muted">View software information</small>
            </div>
            <a href="/software-management" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3" id="softwareDetails">
                        <div class="col-12 text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (async function() {
        const urlParts = window.location.pathname.split('/');
        const softwareId = urlParts[urlParts.length - 1];
        
        try {
            const response = await fetch(`/api/software/${softwareId}`);
            const result = await response.json();
            
            if (result.success) {
                const software = result.data;
                const statusBadge = software.isActive ? 
                    '<span class="badge bg-success">Active</span>' : 
                    '<span class="badge bg-secondary">Inactive</span>';
                
                document.getElementById('softwareDetails').innerHTML = `
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Name</h6>
                        <div class="fw-semibold">${software.name}</div>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Icon</h6>
                        <div class="fw-semibold"><i class="bi ${software.icon}"></i> ${software.icon}</div>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Status</h6>
                        <div>${statusBadge}</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Route</h6>
                        <div class="fw-semibold">${software.route}</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Order</h6>
                        <div class="fw-semibold">${software.order}</div>
                    </div>
                    <div class="col-12">
                        <h6 class="text-muted mb-1">Description</h6>
                        <p class="mb-0">${software.description || 'No description provided'}</p>
                    </div>
                    <div class="col-12">
                        <h6 class="text-muted mb-1">Permissions</h6>
                        <p class="mb-0">${software.permissions && software.permissions.length > 0 ? software.permissions.join(', ') : 'Public (No permissions required)'}</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Created At</h6>
                        <div class="fw-semibold">${new Date(software.createdAt).toLocaleString()}</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Updated At</h6>
                        <div class="fw-semibold">${new Date(software.updatedAt).toLocaleString()}</div>
                    </div>
                `;
            } else {
                Toast.error('Failed to load software data');
                document.getElementById('softwareDetails').innerHTML = '<div class="col-12 text-center text-danger">Failed to load data</div>';
            }
        } catch (error) {
            Toast.error('Failed to load software data');
            document.getElementById('softwareDetails').innerHTML = '<div class="col-12 text-center text-danger">Failed to load data</div>';
        }
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
