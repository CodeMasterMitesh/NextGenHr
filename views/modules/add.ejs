<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Add Module</h5>
                <small class="text-muted">Create new sidebar sub-menu</small>
            </div>
            <a href="/module-management" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <form id="moduleForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Software (Parent Menu) <span class="text-danger">*</span></label>
                                <select class="form-select" name="softwareId" id="softwareId" required>
                                    <option value="">Select Software</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="name" required placeholder="e.g., Employee List">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Icon <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="icon" required placeholder="bi-circle" value="bi-circle">
                                <small class="text-muted">Bootstrap icon class</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Route <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="route" required placeholder="employees">
                                <small class="text-muted">Path to the view</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Order <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="order" required value="0" min="0">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Status</label>
                                <select class="form-select" name="isActive">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="description" rows="3" placeholder="Optional description"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Permissions (comma-separated)</label>
                                <input type="text" class="form-control" name="permissions" placeholder="admin, manager">
                                <small class="text-muted">Leave empty for public access</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Module
                            </button>
                            <a href="/module-management" class="btn btn-secondary" data-spa>
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (async function() {
        // Load software list
        try {
            const response = await fetch('/api/software?list=all');
            const result = await response.json();
            
            if (result.success) {
                const select = document.getElementById('softwareId');
                result.data.forEach(software => {
                    const option = document.createElement('option');
                    option.value = software._id;
                    option.textContent = software.name;
                    select.appendChild(option);
                });
            }
        } catch (error) {
            Toast.error('Failed to load software list');
        }

        // Handle form submission
        document.getElementById('moduleForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = {
                softwareId: formData.get('softwareId'),
                name: formData.get('name'),
                icon: formData.get('icon'),
                route: formData.get('route'),
                order: parseInt(formData.get('order')),
                isActive: formData.get('isActive') === 'true',
                description: formData.get('description'),
                permissions: formData.get('permissions') ? formData.get('permissions').split(',').map(p => p.trim()) : []
            };

            try {
                const response = await fetch('/api/modules', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (result.success) {
                    Toast.success(result.message);
                    setTimeout(() => {
                        if (window.spaNavigate) {
                            window.spaNavigate('/module-management');
                        } else {
                            window.location.href = '/module-management';
                        }
                    }, 500);
                } else {
                    Toast.error(result.message);
                }
            } catch (error) {
                Toast.error('Failed to create module');
            }
        });
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
