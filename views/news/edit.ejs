<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-newspaper me-2"></i>Edit News Article</h2>
    <a href="/news" class="btn btn-secondary">
      <i class="bi bi-arrow-left me-2"></i>Back to News
    </a>
  </div>

  <div class="card">
    <div class="card-body">
      <form id="editNewsForm">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" id="title" value="Company Achieves Record Growth" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="category" class="form-label">Category</label>
            <select class="form-select" id="category" required>
              <option value="">Select Category</option>
              <option value="company" selected>Company News</option>
              <option value="achievement">Achievement</option>
              <option value="announcement">Announcement</option>
              <option value="event">Event</option>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="author" class="form-label">Author</label>
            <input type="text" class="form-control" id="author" value="Admin User" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="publishDate" class="form-label">Publish Date</label>
            <input type="date" class="form-control" id="publishDate" value="2025-01-15" required>
          </div>
        </div>

        <div class="row">
          <div class="col-md-12 mb-3">
            <label for="summary" class="form-label">Summary</label>
            <textarea class="form-control" id="summary" rows="2" required>Company reports 25% growth in Q4 2024</textarea>
          </div>
        </div>

        <div class="row">
          <div class="col-md-12 mb-3">
            <label for="content" class="form-label">Content</label>
            <textarea class="form-control" id="content" rows="8" required>We are thrilled to announce that our company has achieved record growth this quarter...</textarea>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="status" class="form-label">Status</label>
            <select class="form-select" id="status" required>
              <option value="">Select Status</option>
              <option value="draft">Draft</option>
              <option value="published" selected>Published</option>
              <option value="archived">Archived</option>
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label for="tags" class="form-label">Tags</label>
            <input type="text" class="form-control" id="tags" value="growth, achievement, quarterly" placeholder="Comma separated tags">
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-2"></i>Update Article
          </button>
          <a href="/news" class="btn btn-secondary">
            <i class="bi bi-x-circle me-2"></i>Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
