<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Salary Management</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#salaryModal">
            <i class="bi bi-plus-circle"></i> Add Salary
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="card">
            <div class="card-header bg-light">
                <div class="row align-items-center">
                    <div class="col">
                        <h6 class="mb-0">Employee Salary Details</h6>
                    </div>
                    <div class="col-auto">
                        <input type="search" class="form-control form-control-sm" placeholder="Search employee...">
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Employee Code</th>
                                <th>Base Salary</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>John Doe</strong></td>
                                <td>EMP-001</td>
                                <td>₹50,000</td>
                                <td>Senior Developer</td>
                                <td>IT</td>
                                <td>Dec 1, 2025</td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Sarah Smith</strong></td>
                                <td>EMP-002</td>
                                <td>₹40,000</td>
                                <td>HR Manager</td>
                                <td>HR</td>
                                <td>Dec 1, 2025</td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Salary Modal -->
<div class="modal fade" id="salaryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add/Edit Salary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-select">
                            <option>Select Employee</option>
                            <option>John Doe</option>
                            <option>Sarah Smith</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Base Salary</label>
                            <input type="number" class="form-control" placeholder="50000">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Effective From</label>
                            <input type="date" class="form-control">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">HRA (%)</label>
                            <input type="number" class="form-control" placeholder="10" step="0.01">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">DA (%)</label>
                            <input type="number" class="form-control" placeholder="5" step="0.01">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
