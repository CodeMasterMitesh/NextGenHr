<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark me-2"></i>Job Application Details</h2>
    <div>
      <a href="/job-applications/edit/<%= application.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/job-applications" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Applications
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Jane Smith - Senior Developer Application</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Candidate Information</h6>
          <p class="mb-1"><strong>Name:</strong> Jane Smith</p>
          <p class="mb-1"><strong>Email:</strong> jane@email.com</p>
          <p class="mb-1"><strong>Phone:</strong> +91 9876543210</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Application Details</h6>
          <p class="mb-1"><strong>Position:</strong> Senior Developer</p>
          <p class="mb-1"><strong>Application Date:</strong> 10th January 2025</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Shortlisted</span></p>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Resume</h6>
        <p>
          <i class="bi bi-file-pdf me-2 text-danger"></i>
          <a href="#" download>jane_smith_resume.pdf</a>
        </p>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Cover Letter</h6>
        <p>Dear Hiring Team,</p>
        <p>I am writing to express my interest in the Senior Developer position at your company. With my 5+ years of experience in full-stack development...</p>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-1"><strong>Application Tracking:</strong></p>
        <p class="mb-1">Applied: 10/01/2025</p>
        <p class="mb-1">Shortlisted: 12/01/2025</p>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success">
          <i class="bi bi-check-lg me-2"></i>Schedule Interview
        </button>
        <button class="btn btn-danger">
          <i class="bi bi-x-lg me-2"></i>Reject
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
