<% if (!partial) { %>
<%- include ('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Job Applications</h5>
                <small class="text-muted">Manage candidate applications</small>
            </div>
            <a href="/job-applications/add" class="btn btn-primary" data-spa>
                <i class="bi bi-plus-circle"></i> Add Job Application
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <!-- Search Bar -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <form method="GET" action="/job-applications">
                                <div class="input-group">
                                    <input type="text" class="form-control" name="search" placeholder="Search by name, email, position..." value="<%= search %>">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                    <% if (search) { %>
                                    <a href="/job-applications" class="btn btn-outline-danger">
                                        <i class="bi bi-x"></i> Clear
                                    </a>
                                    <% } %>
                                </div>
                            </form>
                        </div>
                        <div class="col-md-6 text-end">
                            <small class="text-muted">Total: <%= pagination.total %> applications</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Candidate Name</th>
                                    <th>Position</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Applied Date</th>
                                    <th>Resume</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (applications && applications.length > 0) { %>
                                    <% applications.forEach(app => { %>
                                        <tr>
                                            <td><%= app.name || 'N/A' %></td>
                                            <td><%= app.position || 'N/A' %></td>
                                            <td><%= app.email || 'N/A' %></td>
                                            <td><%= app.phone || 'N/A' %></td>
                                            <td><%= app.appliedAt ? new Date(app.appliedAt).toLocaleDateString('en-GB') : 'N/A' %></td>
                                            <td>
                                                <% if (app.resume) { %>
                                                    <a href="/<%= app.resume %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-file-earmark-pdf"></i> View
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-muted">No Resume</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <a href="/job-applications/view/<%= app._id %>" class="btn btn-sm btn-info" title="View" data-spa>
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="/job-applications/edit/<%= app._id %>" class="btn btn-sm btn-warning" title="Edit" data-spa>
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button class="btn btn-sm btn-danger" title="Delete" onclick="deleteApplication('<%= app._id %>')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                            <p class="mt-2">No applications found</p>
                                            <% if (search) { %>
                                                <a href="/job-applications" class="btn btn-sm btn-primary">Clear Search</a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination.totalPages > 1) { %>
                    <nav aria-label="Page navigation" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <!-- Previous Button -->
                            <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + search : '' %>">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            </li>
                            
                            <!-- Page Numbers -->
                            <% 
                            let startPage = Math.max(1, pagination.page - 2);
                            let endPage = Math.min(pagination.totalPages, pagination.page + 2);
                            %>
                            
                            <% if (startPage > 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=1<%= search ? '&search=' + search : '' %>">1</a>
                                </li>
                                <% if (startPage > 2) { %>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                <% } %>
                            <% } %>
                            
                            <% for (let i = startPage; i <= endPage; i++) { %>
                                <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %><%= search ? '&search=' + search : '' %>"><%= i %></a>
                                </li>
                            <% } %>
                            
                            <% if (endPage < pagination.totalPages) { %>
                                <% if (endPage < pagination.totalPages - 1) { %>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                <% } %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= pagination.totalPages %><%= search ? '&search=' + search : '' %>"><%= pagination.totalPages %></a>
                                </li>
                            <% } %>
                            
                            <!-- Next Button -->
                            <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + search : '' %>">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

<script>
function deleteApplication(id) {
    if (confirm('Are you sure you want to delete this application?')) {
        fetch(`/api/deleteJobApplication/${id}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showToast('Application deleted successfully', 'success');
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                showToast(data.message || 'Failed to delete application', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('An error occurred while deleting', 'error');
        });
    }
}
</script>

<% if (!partial) { %>
<%- include ('../layouts/footer'); %>
<% } %>
