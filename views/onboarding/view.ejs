<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-check me-2"></i>Onboarding Details</h2>
    <div>
      <a href="/onboarding/edit/<%= onboarding.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/onboarding" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Onboarding
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">Onboarding - Jane Smith</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Employee Information</h6>
          <p class="mb-1"><strong>Name:</strong> Jane Smith</p>
          <p class="mb-1"><strong>Designation:</strong> Senior Developer</p>
          <p class="mb-1"><strong>Department:</strong> IT</p>
          <p class="mb-1"><strong>Joining Date:</strong> 1st February 2025</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Onboarding Details</h6>
          <p class="mb-1"><strong>Buddy:</strong> John Doe</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning">In Progress</span></p>
          <p class="mb-1"><strong>Progress:</strong> 40%</p>
          <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 40%"></div>
          </div>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Onboarding Checklist</h6>
        <div class="list-group">
          <div class="list-group-item">
            <i class="bi bi-check-circle-fill text-success me-2"></i>Document Verification
          </div>
          <div class="list-group-item">
            <i class="bi bi-check-circle-fill text-success me-2"></i>System Access Setup
          </div>
          <div class="list-group-item">
            <i class="bi bi-circle text-muted me-2"></i>Company Orientation
          </div>
          <div class="list-group-item">
            <i class="bi bi-circle text-muted me-2"></i>Initial Training
          </div>
          <div class="list-group-item">
            <i class="bi bi-circle text-muted me-2"></i>Equipment Allocation
          </div>
        </div>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-2"><strong>Notes:</strong></p>
        <p class="text-muted">New employee onboarding in progress</p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
