<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Interview Schedule</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#interviewModal">
            <i class="bi bi-plus-circle"></i> Schedule Interview
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1">12</h3>
                        <p class="text-muted mb-0">Total Interviews</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1 text-success">5</h3>
                        <p class="text-muted mb-0">Scheduled</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1 text-info">4</h3>
                        <p class="text-muted mb-0">In Progress</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h3 class="mb-1 text-warning">3</h3>
                        <p class="text-muted mb-0">Completed</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Interview Schedule</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Candidate</th>
                                <th>Position</th>
                                <th>Interview Type</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Interviewer</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Rahul Sharma</strong></td>
                                <td>Senior Developer</td>
                                <td>Technical</td>
                                <td>Dec 20, 2025</td>
                                <td>10:00 AM</td>
                                <td>John Doe</td>
                                <td><span class="badge bg-warning">Scheduled</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Priya Patel</strong></td>
                                <td>HR Manager</td>
                                <td>HR Round</td>
                                <td>Dec 18, 2025</td>
                                <td>2:00 PM</td>
                                <td>Sarah Smith</td>
                                <td><span class="badge bg-info">In Progress</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Schedule Interview Modal -->
<div class="modal fade" id="interviewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Schedule Interview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Candidate</label>
                        <select class="form-select">
                            <option>Select Candidate</option>
                            <option>Rahul Sharma</option>
                            <option>Priya Patel</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interview Type</label>
                        <select class="form-select">
                            <option>Select Type</option>
                            <option>Technical</option>
                            <option>HR Round</option>
                            <option>Final Round</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date</label>
                            <input type="date" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Time</label>
                            <input type="time" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interviewer</label>
                        <select class="form-select">
                            <option>Select Interviewer</option>
                            <option>John Doe</option>
                            <option>Sarah Smith</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meeting Link (Zoom/Google Meet)</label>
                        <input type="url" class="form-control" placeholder="https://zoom.us/...">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Schedule</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
