<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-x me-2"></i>Week-off Details</h2>
    <div>
      <a href="/weekoff/edit/<%= weekoff.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/weekoff" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Week-off
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Week-off Configuration</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Employee Information</h6>
          <p class="mb-1"><strong>Name:</strong> John Doe</p>
          <p class="mb-1"><strong>Employee Code:</strong> EMP001</p>
          <p class="mb-1"><strong>Department:</strong> IT</p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Configuration Details</h6>
          <p class="mb-1"><strong>Type:</strong> Weekly</p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
        </div>
      </div>

      <hr>

      <div class="row mb-4">
        <div class="col-md-12">
          <h6 class="text-muted">Week-off Days</h6>
          <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-success">Sunday</span>
            <span class="badge bg-success">Saturday</span>
          </div>
        </div>
      </div>

      <hr>

      <div class="row mb-4">
        <div class="col-md-6">
          <p class="mb-2"><strong>Effective From:</strong> 01/01/2025</p>
        </div>
        <div class="col-md-6">
          <p class="mb-2"><strong>Effective To:</strong> 31/12/2025</p>
        </div>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-2"><strong>Notes:</strong></p>
        <p class="text-muted">Standard weekend off</p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
