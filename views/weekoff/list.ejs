<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Week-off Management</h5>
                <small class="text-muted">Configure weekly offs</small>
            </div>
            <a href="/weekoff/add" class="btn btn-primary" data-spa>
                <i class="bi bi-plus-circle"></i> Add Week-off
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover" id="weekoffTable">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th>Day</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Support</td>
                                    <td>Sunday</td>
                                    <td>
                                        <a href="/weekoff/view/1" class="btn btn-sm btn-info" data-spa><i class="bi bi-eye"></i></a>
                                        <a href="/weekoff/edit/1" class="btn btn-sm btn-warning" data-spa><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function initWeekoffList(){
      if (window.$ && $.fn.DataTable) {
        $('#weekoffTable').DataTable({ order: [] });
      }
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
