<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Asset Issue</h5>
                <small class="text-muted">Issue assets to employees</small>
            </div>
            <a href="/assets/issue" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Issue Asset
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Asset Name</th>
                                    <th>Asset Code</th>
                                    <th>Employee</th>
                                    <th>Issue Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Laptop - Dell XPS</td>
                                    <td>ASSET-001</td>
                                    <td>John Doe</td>
                                    <td>2025-12-20</td>
                                    <td><span class="badge bg-success">Issued</span></td>
                                    <td>
                                        <a href="/assets/view/1" class="btn btn-sm btn-info" title="View"><i class="bi bi-eye"></i></a>
                                        <a href="/assets/return/1" class="btn btn-sm btn-warning" title="Return"><i class="bi bi-arrow-return-left"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
