<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Resume Management</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class="bi bi-upload"></i> Upload Resume
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="card">
            <div class="card-header bg-light">
                <div class="row align-items-center">
                    <div class="col">
                        <h6 class="mb-0">Candidate Resumes</h6>
                    </div>
                    <div class="col-auto">
                        <input type="search" class="form-control form-control-sm" placeholder="Search candidate...">
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Candidate Name</th>
                                <th>Position Applied</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Upload Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Rahul Sharma</strong></td>
                                <td>Senior Developer</td>
                                <td>rahul@email.com</td>
                                <td>+91-9876-543210</td>
                                <td>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star text-warning"></i>
                                </td>
                                <td><span class="badge bg-info">Under Review</span></td>
                                <td>Dec 15, 2025</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-primary"><i class="bi bi-download"></i> PDF</a>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Priya Patel</strong></td>
                                <td>HR Manager</td>
                                <td>priya@email.com</td>
                                <td>+91-9876-543211</td>
                                <td>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <i class="bi bi-star-fill text-warning"></i>
                                </td>
                                <td><span class="badge bg-success">Selected</span></td>
                                <td>Dec 12, 2025</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-primary"><i class="bi bi-download"></i> PDF</a>
                                    <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Resume Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Resume</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Candidate Name</label>
                        <input type="text" class="form-control" placeholder="Full name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="Email address">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="tel" class="form-control" placeholder="Phone number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Position Applied</label>
                        <select class="form-select">
                            <option>Select Position</option>
                            <option>Senior Developer</option>
                            <option>HR Manager</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Resume File</label>
                        <input type="file" class="form-control" accept=".pdf,.doc,.docx">
                        <small class="text-muted">Supported: PDF, DOC, DOCX</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Upload</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
