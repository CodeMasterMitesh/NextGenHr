<% if (!partial) { %>
<%- include('../layouts/header'); %>
<% } %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Add Earnings/Deductions</h5>
                <small class="text-muted">Create payroll component</small>
            </div>
            <a href="/earnings-deductions" class="btn btn-secondary" data-spa>
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <form id="earningsAddForm" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Type</label>
                            <select class="form-select" name="type">
                                <option value="earning">Earning</option>
                                <option value="deduction">Deduction</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name" placeholder="Component name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Amount</label>
                            <input type="number" class="form-control" name="amount" placeholder="0.00" step="0.01">
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/earnings-deductions" class="btn btn-secondary" data-spa><i class="bi bi-x-circle"></i> Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function initEarningsAdd(){
      const form = document.getElementById('earningsAddForm');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (window.Toast) Toast.success('Entry saved (demo)');
        if (window.spaNavigate) spaNavigate('/earnings-deductions'); else window.location.href = '/earnings-deductions';
      });
    })();
    </script>
<% if (!partial) { %>
<%- include('../layouts/footer'); %>
<% } %>
