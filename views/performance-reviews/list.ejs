<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Performance Reviews</h5>
                <small class="text-muted">Manage employee performance reviews</small>
            </div>
            <a href="/performance-reviews/add" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Review
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Review Period</th>
                                    <th>Reviewer</th>
                                    <th>Rating</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>John Doe</td>
                                    <td>Q4 2025</td>
                                    <td>Sarah Manager</td>
                                    <td><span class="badge bg-success">4.5/5</span></td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                    <td>
                                        <a href="/performance-reviews/view/1" class="btn btn-sm btn-info" title="View"><i class="bi bi-eye"></i></a>
                                        <a href="/performance-reviews/edit/1" class="btn btn-sm btn-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
