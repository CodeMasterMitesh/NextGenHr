<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Asset Issue</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#issueModal">
            <i class="bi bi-plus-circle"></i> Issue Asset
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Total Assets Issued</h6>
                        <h3 class="mb-0">145</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="mb-0">12</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Pending Returns</h6>
                        <h3 class="mb-0">8</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Asset Issue Records</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Asset ID</th>
                                <th>Asset Type</th>
                                <th>Serial Number</th>
                                <th>Issued To</th>
                                <th>Issue Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>AST-001</strong></td>
                                <td><span class="badge bg-primary">Laptop</span></td>
                                <td>LAP-12345</td>
                                <td>John Doe</td>
                                <td>Dec 10, 2025</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Issue Asset Modal -->
<div class="modal fade" id="issueModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Issue Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-select">
                            <option>Select Employee</option>
                            <option>John Doe</option>
                            <option>Sarah Smith</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Asset Type</label>
                        <select class="form-select">
                            <option>Select Type</option>
                            <option>Laptop</option>
                            <option>Desktop</option>
                            <option>Mobile</option>
                            <option>Monitor</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Serial Number</label>
                        <input type="text" class="form-control" placeholder="Serial number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Issue Date</label>
                        <input type="date" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Issue</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
