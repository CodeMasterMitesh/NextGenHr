<% if (!partial) { %>
    </main>
 <!-- SPA Router (load after content) -->
 <script src="/js/spa.js"></script>
 <script>
    function logout() {
        if (confirm('Are you sure you want to logout?')) {
            localStorage.removeItem('user');
            Toast.info('Logging out...');
            setTimeout(() => {
                window.location.href = '/login';
            }, 500);
        }
    }
    // Invoke page-specific initializers if defined
    if (typeof window.initEmployeesTable === 'function') {
        window.initEmployeesTable();
    }
 </script>
</body>
</html>
<% } %>