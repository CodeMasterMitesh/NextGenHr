            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Payroll</h6>
                <a class="nav-link" href="/shift-management">
                    <i class="bi bi-clock"></i> <span>Shift Management</span>
                </a>

                <a class="nav-link" href="/attendance">
                    <i class="bi bi-clock-history"></i> <span>Attendance</span>
                </a>

                <a class="nav-link" href="/salary">
                    <i class="bi bi-cash-stack"></i> <span>Salary</span>
                </a>

                <a class="nav-link" href="/weekoff">
                    <i class="bi bi-calendar-x"></i> <span>Weekoff</span>
                </a>

                <a class="nav-link" href="/leaves">
                    <i class="bi bi-calendar-check"></i> <span>Leaves</span>
                </a>

                <a class="nav-link" href="/earnings-deductions">
                    <i class="bi bi-arrow-left-right"></i> <span>Earnings & Deductions</span>
                </a>
            </div>

            <!-- Performance & Asset -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Performance & Assets</h6>
                <a class="nav-link" href="/performance-reviews">
                    <i class="bi bi-star"></i> <span>Performance Reviews</span>
                </a>

                <a class="nav-link" href="/asset-issue">
                    <i class="bi bi-box2-heart"></i> <span>Asset Issue</span>
                </a>

                <a class="nav-link" href="/asset-return">
                    <i class="bi bi-box2-arrow-in"></i> <span>Asset Return</span>
                </a>
            </div>

            <!-- Tasks & Events -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Tasks & Events</h6>
                <a class="nav-link" href="/tasks">
                    <i class="bi bi-list-check"></i> <span>Task Management</span>
                </a>

                <a class="nav-link" href="/events">
                    <i class="bi bi-calendar2-event"></i> <span>Events</span>
                </a>
            </div>

            <!-- Common -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Common</h6>
                <a class="nav-link" href="/news">
                    <i class="bi bi-newspaper"></i> <span>News & Articles</span>
                </a>

                <a class="nav-link" href="/notifications">
                    <i class="bi bi-bell"></i> <span>Notifications</span>
                </a>

                <a class="nav-link" href="/holidays">
                    <i class="bi bi-calendar-heart"></i> <span>Holidays</span>
                </a>
            </div>
        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer border-top p-3 mt-auto">
            <div class="d-flex align-items-center gap-2 mb-2">
                <img src="https://via.placeholder.com/32" class="rounded-circle" alt="User">
                <div class="small">
                    <div class="fw-bold">Admin</div>
                    <div class="text-muted">admin@company.com</div>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-secondary w-100" onclick="logout()">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>
