<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NextGenHR - Employee Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>

<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
    <!-- Sidebar Navigation -->
    <aside class="sidebar d-none d-md-flex flex-column">
        <div class="sidebar-brand p-4 border-bottom">
            <h5 class="mb-0"><i class="bi bi-briefcase-fill"></i> NextGenHR</h5>
            <small class="text-muted">Employee Management</small>
        </div>
        
        <nav class="nav flex-column flex-grow-1 p-3">
            <!-- Main Menu -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Menu</h6>
                <a class="nav-link active" href="/dashboard">
                    <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                </a>
            </div>

            <!-- HR Management -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">HR Management</h6>
                <a class="nav-link" href="/employees">
                    <i class="bi bi-people-fill"></i> <span>Employees</span>
                </a>

                <a class="nav-link" href="/departments">
                    <i class="bi bi-diagram-3"></i> <span>Departments</span>
                </a>

                <a class="nav-link" href="/designations">
                    <i class="bi bi-diagram-2"></i> <span>Designations</span>
                </a>

                <a class="nav-link" href="/branches">
                    <i class="bi bi-geo-alt"></i> <span>Branches</span>
                </a>

                <a class="nav-link" href="/company">
                    <i class="bi bi-building"></i> <span>Company</span>
                </a>
            </div>

            <!-- Attendance & Leave -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Attendance & Leave</h6>
                <a class="nav-link" href="/attendance">
                    <i class="bi bi-clock-history"></i> <span>Attendance</span>
                </a>

                <a class="nav-link" href="/leave-requests">
                    <i class="bi bi-calendar-check"></i> <span>Leave Requests</span>
                </a>
            </div>

            <!-- Payroll & Performance -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Payroll & Performance</h6>
                <a class="nav-link" href="/payroll">
                    <i class="bi bi-cash-stack"></i> <span>Payroll</span>
                </a>

                <a class="nav-link" href="/payslips">
                    <i class="bi bi-receipt"></i> <span>Payslips</span>
                </a>

                <a class="nav-link" href="/performance-reviews">
                    <i class="bi bi-star"></i> <span>Performance Reviews</span>
                </a>
            </div>

            <!-- Administration -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Administration</h6>
                <a class="nav-link" href="/users">
                    <i class="bi bi-person-gear"></i> <span>Users</span>
                </a>

                <a class="nav-link" href="/roles">
                    <i class="bi bi-shield-lock"></i> <span>Roles & Permissions</span>
                </a>

                <a class="nav-link" href="/audit-logs">
                    <i class="bi bi-file-earmark-text"></i> <span>Audit Logs</span>
                </a>

                <a class="nav-link" href="/approvals">
                    <i class="bi bi-check2-square"></i> <span>Approvals</span>
                </a>
            </div>

            <!-- Recruitment -->
            <div class="nav-section mb-3">
                <h6 class="nav-label px-2 text-uppercase text-muted small">Recruitment</h6>
                <a class="nav-link" href="/job-requisition">
                    <i class="bi bi-file-earmark-plus"></i> <span>Job Requisition</span>
                </a>

                <a class="nav-link" href="/job-posting">
