                if (savedScrollPos) {
                    sidebar.scrollTop = parseInt(savedScrollPos);
                }
            }
        })();
    </script>

    <script>
        // Sidebar collapse/expand functionality
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.querySelector('.sidebar');
            const mainContent = document.querySelector('.main-content');
            
            // Check localStorage for saved state
            const savedState = localStorage.getItem('sidebarCollapsed');
            if (savedState === 'true') {
                sidebar.classList.add('collapsed');
                if (mainContent) mainContent.classList.add('expanded');
            }
            
            // Toggle sidebar
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                if (mainContent) mainContent.classList.toggle('expanded');
                
                // Save state
                const isCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('sidebarCollapsed', isCollapsed);
            });
        });
    </script>

    <script>
        // Convert existing topbars into breadcrumb bars and remove extra spacing
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.topbar').forEach(bar => {
                const textBlock = bar.querySelector('div');
                const titleEl = bar.querySelector('h5');
                const title = titleEl ? titleEl.textContent.trim() : '';

                if (!textBlock || !title) return;

                const breadcrumbNav = document.createElement('nav');
                breadcrumbNav.className = 'breadcrumb-bar';
                breadcrumbNav.setAttribute('aria-label', 'breadcrumb');
                breadcrumbNav.innerHTML = `
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">${title}</li>
                    </ol>
                `;

                textBlock.innerHTML = '';
                textBlock.appendChild(breadcrumbNav);

                const heading = document.createElement('h5');
                heading.className = 'mb-0';
                heading.textContent = title;
                textBlock.appendChild(heading);
            });
        });
    </script>

    <script>
        // Collapsible menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            const menuToggles = document.querySelectorAll('.nav-menu-toggle');
            
            menuToggles.forEach(toggle => {
                toggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('data-target');
                    const submenu = document.getElementById(targetId);
                    
                    if (submenu) {
                        submenu.classList.toggle('show');
                        this.classList.toggle('active');
                        
                        // Save state
                        const state = submenu.classList.contains('show');
                        sessionStorage.setItem('menu-' + targetId, state);
                    }
                });
            });
            
            // Restore menu states
            menuToggles.forEach(toggle => {
                const targetId = toggle.getAttribute('data-target');
                const savedState = sessionStorage.getItem('menu-' + targetId);
                if (savedState === 'true') {
                    const submenu = document.getElementById(targetId);
                    if (submenu) {
                        submenu.classList.add('show');
                        toggle.classList.add('active');
                    }
                }
            });
            
            // Set active sidebar link based on current page
            const currentPath = window.location.pathname;
            const sidebarLinks = document.querySelectorAll('.sidebar .nav-link-sub');
            const sidebar = document.querySelector('.sidebar');
            
            sidebarLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (currentPath === href || currentPath.startsWith(href.replace(/\/$/, ''))) {
                    link.classList.add('active');
                    
                    // Auto-open parent menu
                    const submenu = link.closest('.nav-submenu');
                    if (submenu) {
                        submenu.classList.add('show');
                        const toggle = submenu.previousElementSibling;
                        if (toggle) {
                            toggle.classList.add('active');
                        }
                    }
                } else {
                    link.classList.remove('active');
                }
                
                // Save scroll position when clicking
                link.addEventListener('click', function() {
                    if (sidebar) {
                        sessionStorage.setItem('sidebarScrollPos', sidebar.scrollTop);
                    }
                });
            });
            
            // Main dashboard link
            const dashboardLink = document.querySelector('.sidebar .nav-link[href="/dashboard"]');
            if (dashboardLink) {
                if (currentPath === '/' || currentPath === '/dashboard') {
                    dashboardLink.classList.add('active');
                } else {
                    dashboardLink.classList.remove('active');
                }
            }
        });

        // Logout function
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                sessionStorage.removeItem('sidebarScrollPos');
                window.location.href = '/login';
            }
        }
    </script>

