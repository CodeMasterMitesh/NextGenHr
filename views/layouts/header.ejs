    <!-- Restore scroll position immediately -->
    <script>
        (function() {
            const sidebar = document.querySelector('.sidebar');
            if (sidebar) {
                const savedScrollPos = sessionStorage.getItem('sidebarScrollPos');
                if (savedScrollPos) {
                    sidebar.scrollTop = parseInt(savedScrollPos);
                }
            }
        })();
    </script>

    <script>
        // Set active sidebar link based on current page
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const sidebarLinks = document.querySelectorAll('.sidebar .nav-link');
            const sidebar = document.querySelector('.sidebar');
            
            sidebarLinks.forEach(link => {
                // Remove active class from all links first
                link.classList.remove('active');
                
                // Get the href of the link
                const href = link.getAttribute('href');
                
                // Check if current path matches the link href
                if (currentPath === href || (href !== '/dashboard' && currentPath.startsWith(href))) {
                    link.classList.add('active');
                }
                
                // Save scroll position when clicking sidebar links
                link.addEventListener('click', function(e) {
                    if (sidebar) {
                        sessionStorage.setItem('sidebarScrollPos', sidebar.scrollTop);
                    }
                });
            });
            
            // If no match found, set dashboard as active for home page
            if (currentPath === '/' || currentPath === '') {
                const dashboardLink = document.querySelector('.sidebar .nav-link[href="/dashboard"]');
                if (dashboardLink) {
                    dashboardLink.classList.add('active');
                }
            }
        });

        // Logout function
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                sessionStorage.removeItem('sidebarScrollPos');
                window.location.href = '/login';
            }
        }
    </script>