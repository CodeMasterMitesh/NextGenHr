                </a>

                <a class="nav-link" href="/resumes">
                    <i class="bi bi-file-earmark-pdf"></i> <span>Resumes</span>
                </a>

                <a class="nav-link" href="/interview-schedule">
                    <i class="bi bi-calendar-event"></i> <span>Interview Schedule</span>
                </a>

                <a class="nav-link" href="/onboarding">
                    <i class="bi bi-person-check"></i> <span>Onboarding</span>
                </a>

                <a class="nav-link" href="/training-schedule">
                    <i class="bi bi-book"></i> <span>Training Schedule</span>
                </a>

                <a class="nav-link" href="/exam">
                    <i class="bi bi-clipboard-check"></i> <span>Exams</span>
                </a>
