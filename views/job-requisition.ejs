<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil-square me-2"></i>Job Requisitions</h2>
    <a href="/job-requisition/add" class="btn btn-primary">
      <i class="bi bi-plus-circle me-2"></i>New Requisition
    </a>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="row align-items-center">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Search requisitions...">
          </div>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Position</th>
            <th>Department</th>
            <th>Count</th>
            <th>Budget</th>
            <th>Status</th>
            <th>Created Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Senior Developer</td>
            <td>IT</td>
            <td>2</td>
            <td>₹30,00,000</td>
            <td><span class="badge bg-warning">Pending Approval</span></td>
            <td>10/01/2025</td>
            <td>
              <button class="btn btn-sm btn-info">View</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
