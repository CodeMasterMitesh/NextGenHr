<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history me-2"></i>Audit Logs</h2>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="row align-items-center">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Search logs...">
          </div>
        </div>
        <div class="col-md-4 text-end">
          <button class="btn btn-outline-secondary me-2">
            <i class="bi bi-funnel me-2"></i>Filter
          </button>
          <button class="btn btn-outline-primary">
            <i class="bi bi-download me-2"></i>Export
          </button>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Date & Time</th>
            <th>User</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Changes</th>
            <th>IP Address</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>15/01/2025 10:30 AM</td>
            <td>Admin User</td>
            <td><span class="badge bg-success">Created</span></td>
            <td>Employee - John Doe</td>
            <td>New employee added</td>
            <td>192.168.1.100</td>
          </tr>
          <tr>
            <td>15/01/2025 09:15 AM</td>
            <td>HR Manager</td>
            <td><span class="badge bg-warning">Updated</span></td>
            <td>Leave Request</td>
            <td>Status changed to Approved</td>
            <td>192.168.1.101</td>
          </tr>
          <tr>
            <td>14/01/2025 04:45 PM</td>
            <td>Admin User</td>
            <td><span class="badge bg-danger">Deleted</span></td>
            <td>Event</td>
            <td>Old event removed</td>
            <td>192.168.1.100</td>
          </tr>
          <tr>
            <td>14/01/2025 02:20 PM</td>
            <td>Finance Manager</td>
            <td><span class="badge bg-info">Viewed</span></td>
            <td>Payroll Report</td>
            <td>Document accessed</td>
            <td>192.168.1.102</td>
          </tr>
          <tr>
            <td>14/01/2025 11:00 AM</td>
            <td>Admin User</td>
            <td><span class="badge bg-warning">Updated</span></td>
            <td>User Role</td>
            <td>Permissions modified</td>
            <td>192.168.1.100</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="card-footer">
      <nav>
        <ul class="pagination justify-content-end mb-0">
          <li class="page-item disabled">
            <a class="page-link" href="#">Previous</a>
          </li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item">
            <a class="page-link" href="#">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
