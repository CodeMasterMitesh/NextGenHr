<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Designation Details</h5>
                <small class="text-muted">View complete designation information</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/designations/edit/<%= designation?._id || '' %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/designations" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Designation Title</label>
                            <p class="fw-bold"><%= designation?.title || 'N/A' %></p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Code</label>
                            <p class="fw-bold"><%= designation?.code || 'N/A' %></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Department</label>
                            <p class="fw-bold"><%= designation?.department_name || 'N/A' %></p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Level</label>
                            <p><span class="badge bg-primary"><%= designation?.level || 'N/A' %></span></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="text-muted small">Description</label>
                            <p class="fw-bold"><%= designation?.description || 'No description provided' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
