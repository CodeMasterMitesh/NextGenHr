<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-bell me-2"></i>Notification Details</h2>
    <div>
      <a href="/notifications/edit/<%= notification.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/notifications" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Notifications
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-info text-white">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0">System Maintenance Notice</h5>
        <span class="badge bg-warning">Medium Priority</span>
      </div>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Notification Details</h6>
          <p class="mb-1"><strong>Type:</strong> <span class="badge bg-info">Information</span></p>
          <p class="mb-1"><strong>Priority:</strong> <span class="badge bg-warning">Medium</span></p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Sent</span></p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Delivery Information</h6>
          <p class="mb-1"><strong>Send To:</strong> All Employees</p>
          <p class="mb-1"><strong>Send Date:</strong> 20th January 2025, 09:00 AM</p>
          <p class="mb-1"><strong>Recipients:</strong> 150</p>
          <p class="mb-1"><strong>Read:</strong> 120 (80%)</p>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Message</h6>
        <p>The system will undergo maintenance on January 20th from 10 PM to 2 AM. Please save your work accordingly.</p>
      </div>

      <hr>

      <div class="mb-3">
        <h6 class="text-muted">Delivery Channels</h6>
        <p class="mb-1">
          <i class="bi bi-check-circle-fill text-success me-2"></i>Email Notification
        </p>
        <p class="mb-1">
          <i class="bi bi-x-circle text-muted me-2"></i>SMS Notification
        </p>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-1"><strong>Created:</strong> 15/01/2025 by Admin User</p>
        <p class="mb-1"><strong>Last Updated:</strong> 18/01/2025</p>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary">
          <i class="bi bi-arrow-repeat me-2"></i>Resend
        </button>
        <button class="btn btn-info">
          <i class="bi bi-eye me-2"></i>View Recipients
        </button>
        <button class="btn btn-secondary">
          <i class="bi bi-graph-up me-2"></i>View Analytics
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
