<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-event me-2"></i>Holiday Details</h2>
    <div>
      <a href="/holiday/edit/<%= holiday.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/holiday" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to holiday
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">Republic Day</h5>
    </div>
    <div class="card-body">
      <div class="row mb-3">
        <div class="col-md-6">
          <p class="mb-2"><strong>Date:</strong> 26th January 2025</p>
          <p class="mb-2"><strong>Day:</strong> Sunday</p>
        </div>
        <div class="col-md-6">
          <p class="mb-2"><strong>Type:</strong> <span class="badge bg-primary">National Holiday</span></p>
          <p class="mb-2"><strong>Applicable To:</strong> All Employees</p>
        </div>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-2"><strong>Description:</strong></p>
        <p class="text-muted">Celebrating the Constitution of India</p>
      </div>

      <hr>

      <div class="mb-3">
        <p class="mb-2"><strong>Created:</strong> 01/01/2025</p>
        <p class="mb-2"><strong>Created By:</strong> Admin User</p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
