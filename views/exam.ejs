<%- include ('layouts/header'); %>
<div class="main-content">
    <div class="topbar">
        <h5>Employee Exams</h5>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#examModal">
            <i class="bi bi-plus-circle"></i> New Exam
        </button>
    </div>

    <div class="container-fluid mt-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Exam Schedule</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Exam Name</th>
                                <th>Category</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Duration</th>
                                <th>Total Questions</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Java Programming</strong></td>
                                <td><span class="badge bg-primary">Technical</span></td>
                                <td>Dec 20, 2025</td>
                                <td>10:00 AM</td>
                                <td>60 min</td>
                                <td>50</td>
                                <td><span class="badge bg-warning">Scheduled</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>HR Policies</strong></td>
                                <td><span class="badge bg-info">Compliance</span></td>
                                <td>Dec 18, 2025</td>
                                <td>2:00 PM</td>
                                <td>30 min</td>
                                <td>25</td>
                                <td><span class="badge bg-success">Completed</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header bg-light">
                <h6 class="mb-0">Results</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Exam</th>
                                <th>Score</th>
                                <th>Percentage</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>John Developer</td>
                                <td>Java Programming</td>
                                <td>42/50</td>
                                <td>84%</td>
                                <td><span class="badge bg-success">Passed</span></td>
                                <td>Dec 18, 2025</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Exam Modal -->
<div class="modal fade" id="examModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Exam</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Exam Name</label>
                            <input type="text" class="form-control" placeholder="Exam title">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select">
                                <option>Select Category</option>
                                <option>Technical</option>
                                <option>Compliance</option>
                                <option>Skill Assessment</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Date</label>
                            <input type="date" class="form-control">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Time</label>
                            <input type="time" class="form-control">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Duration (Minutes)</label>
                            <input type="number" class="form-control" placeholder="60">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Total Questions</label>
                            <input type="number" class="form-control" placeholder="50">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Passing Score (%)</label>
                            <input type="number" class="form-control" placeholder="60">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Create</button>
            </div>
        </div>
    </div>
</div>

<%- include ('layouts/footer'); %>
