<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-book me-2"></i>Training Details</h2>
    <div>
      <a href="/training-schedule/edit/<%= training.id || '1' %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil me-2"></i>Edit
      </a>
      <a href="/training-schedule" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Training
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">React Advanced Training</h5>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="text-muted">Training Information</h6>
          <p class="mb-1"><strong>Trainer:</strong> John Doe</p>
          <p class="mb-1"><strong>Duration:</strong> 40 hours</p>
          <p class="mb-1"><strong>Mode:</strong> <span class="badge bg-info">Online</span></p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">Scheduled</span></p>
        </div>
        <div class="col-md-6">
          <h6 class="text-muted">Schedule Details</h6>
          <p class="mb-1"><strong>Start Date:</strong> 1st February 2025</p>
          <p class="mb-1"><strong>End Date:</strong> 5th February 2025</p>
          <p class="mb-1"><strong>Location:</strong> <a href="https://zoom.us/j/123456" target="_blank">Zoom Link</a></p>
          <p class="mb-1"><strong>Max Participants:</strong> 20</p>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Description</h6>
        <p class="text-muted">Advanced React concepts including hooks, context, and performance optimization</p>
      </div>

      <hr>

      <div class="mb-4">
        <h6 class="text-muted">Participants (12/20)</h6>
        <div class="d-flex gap-2 flex-wrap">
          <span class="badge bg-primary">Jane Smith</span>
          <span class="badge bg-primary">Mike Johnson</span>
          <span class="badge bg-primary">Sarah Williams</span>
          <span class="badge bg-primary">+ 9 more</span>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success">
          <i class="bi bi-people me-2"></i>Manage Participants
        </button>
        <button class="btn btn-info">
          <i class="bi bi-file-earmark me-2"></i>View Materials
        </button>
        <button class="btn btn-warning">
          <i class="bi bi-star me-2"></i>View Feedback
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
