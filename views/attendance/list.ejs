<%- include ('../layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Attendance</h5>
                <small class="text-muted">Track employee attendance</small>
            </div>
            <a href="/attendance/mark" class="btn btn-primary">
                <i class="bi bi-clock"></i> Mark Attendance
            </a>
        </div>

        <div class="container-fluid mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Date</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>John Doe</td>
                                    <td>2025-12-30</td>
                                    <td>09:00 AM</td>
                                    <td>06:00 PM</td>
                                    <td><span class="badge bg-success">Present</span></td>
                                    <td>
                                        <a href="/attendance/view/1" class="btn btn-sm btn-info" title="View"><i class="bi bi-eye"></i></a>
                                        <a href="/attendance/edit/1" class="btn btn-sm btn-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('../layouts/footer'); %>
