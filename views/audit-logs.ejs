<%- include ('layouts/header'); %>
    <div class="main-content">
        <div class="topbar">
            <div>
                <h5 class="mb-1">Audit Logs</h5>
                <small class="text-muted">System activity logs</small>
            </div>
        </div>

        <div class="container-fluid mt-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">User</label>
                            <select class="form-select" id="userFilter">
                                <option value="">All Users</option>
                                <option value="1">Admin</option>
                                <option value="2">Manager</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Action</label>
                            <select class="form-select" id="actionFilter">
                                <option value="">All Actions</option>
                                <option value="CREATE">Create</option>
                                <option value="UPDATE">Update</option>
                                <option value="DELETE">Delete</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Date</label>
                            <input type="date" class="form-control" id="dateFilter">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Action</th>
                                    <th>Module</th>
                                    <th>Changes</th>
                                    <th>Date/Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Admin</td>
                                    <td><span class="badge bg-success">CREATE</span></td>
                                    <td>Employee</td>
                                    <td>New employee John Doe added</td>
                                    <td>18 Dec 2024 10:45 AM</td>
                                </tr>
                                <tr>
                                    <td>Admin</td>
                                    <td><span class="badge bg-warning">UPDATE</span></td>
                                    <td>Leave Request</td>
                                    <td>Status changed to Approved</td>
                                    <td>18 Dec 2024 10:30 AM</td>
                                </tr>
                                <tr>
                                    <td>Manager</td>
                                    <td><span class="badge bg-info">VIEW</span></td>
                                    <td>Payroll</td>
                                    <td>Viewed payroll for Dec 2024</td>
                                    <td>18 Dec 2024 09:15 AM</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include ('layouts/footer'); %>
