<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right me-2"></i>View Job Post Details</h2>
    <a href="/jobpost" class="btn btn-secondary">
      <i class="bi bi-arrow-left me-2"></i>Back to Job Posts
    </a>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Senior Developer</h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <p><strong>Company:</strong> NextGen Technologies</p>
              <p><strong>Department:</strong> IT</p>
              <p><strong>Location:</strong> Remote / On-site</p>
            </div>
            <div class="col-md-6">
              <p><strong>Employment Type:</strong> Full-time</p>
              <p><strong>Experience Level:</strong> Senior</p>
              <p><strong>Salary Range:</strong> ₹15,00,000 - ₹20,00,000 p.a.</p>
            </div>
          </div>

          <hr>

          <div class="mb-3">
            <h6>Job Description</h6>
            <p>We are looking for a Senior Developer to join our dynamic IT team. The ideal candidate should have expertise in full-stack development and proven experience in leading technical projects.</p>
          </div>

          <div class="mb-3">
            <h6>Key Responsibilities</h6>
            <ul>
              <li>Design and develop software solutions</li>
              <li>Lead technical teams and mentor junior developers</li>
              <li>Participate in code reviews and quality assurance</li>
              <li>Collaborate with stakeholders</li>
            </ul>
          </div>

          <div class="mb-3">
            <h6>Required Skills</h6>
            <ul>
              <li>JavaScript / Node.js</li>
              <li>React or Angular</li>
              <li>MongoDB / SQL</li>
              <li>5+ years of development experience</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card mb-4">
        <div class="card-header">
          <h6 class="mb-0">Quick Info</h6>
        </div>
        <div class="card-body">
          <p class="mb-2"><strong>Posted:</strong> 15/01/2025</p>
          <p class="mb-2"><strong>Deadline:</strong> 31/01/2025</p>
          <p class="mb-2"><strong>Applications:</strong> 25</p>
          <p class="mb-2"><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
        </div>
      </div>

      <button class="btn btn-primary w-100">
        <i class="bi bi-file-earmark-text me-2"></i>Apply Now
      </button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
